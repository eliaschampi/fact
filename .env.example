APP_NAME=NecoFact
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE
APP_TIMEZONE=America/Lima

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=necofact
DB_USERNAME=shaun
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sistema@necofact.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

NECOFACT_SEED_ADMIN_LOGIN=
NECOFACT_SEED_ADMIN_PASSWORD=

SUNAT_ENVIRONMENT=beta
SUNAT_CERTIFICATE_PATH=
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_SOL_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_GRE_CLIENT_ID=
SUNAT_GRE_CLIENT_SECRET=

PDF_BINARY_PATH=
PDF_TIMEOUT_MS=15000
PDF_MAX_CONCURRENCY=2
PDF_MAX_QUEUE=8
